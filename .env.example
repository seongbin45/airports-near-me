# Supabase (대시보드 → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# AI 제공자 예비 체계 — 키와 모델 id가 모두 있는 제공자만, AI_PROVIDERS 순서대로 시도
# 하나도 없으면 "AI 요약" 버튼이 "제공자 없음"으로 응답
AI_PROVIDERS=claude,openai,gemini,xai
AI_HTTP_RETRIES=2
ANTHROPIC_API_KEY=
# claude-opus-5-5: temperature·top_p는 지정할 수 없다(400). 깊이는 effort로만 조절한다(기본 medium, 이 서비스는 low)
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
# 공공데이터포털 일반 인증키(Decoding) — 한국공항공사 운항 스케줄 GW + 국토교통부 TAGO 국내항공운항정보
DATA_GO_KR_KEY=
# 운항 스케줄 동기화: 호출 인증용 임의 문자열 / Supabase secret key (서버에서만 사용)
CRON_SECRET=
# service role 키. secret 키(sb_secret_…) 또는 service_role JWT(eyJ…)여야 한다.
# publishable 키(sb_publishable_…)를 넣으면 DB 쓰기가 RLS에 막혀 동기화가 전부 실패한다(42501).
SUPABASE_SERVICE_ROLE_KEY=
# 집 → 공항 이동 시간 (npm run geocode-regions / npm run access-times)
# KAKAO_REST_KEY: 카카오디벨로퍼스 REST 키. 로컬 API(주소 검색)와 카카오모빌리티 길찾기에 함께 쓴다. (차량 소요시간)
# ODSAY_KEY: ODsay 대중교통 길찾기 키 (대중교통 소요시간). 무료 서비스 유형은 일 호출 한도가 있다.
KAKAO_REST_KEY=
ODSAY_KEY=
# 지도 API 예비 체계 — 앞 제공자의 한도가 다 되면 다음으로 넘어간다 (키가 없는 제공자는 건너뜀)
#   차량 이동 시간: 카카오모빌리티 → TMAP → 네이버 Directions 5 → OSRM(키 없음)
#   주소 → 좌표:   카카오 로컬 → 네이버 Geocoding → Nominatim(키 없음)
# TMAP_APP_KEY: SK open API(openapi.sk.com) 앱 키 — TMAP 자동차 경로안내
TMAP_APP_KEY=
# NAVER_MAP_CLIENT_ID / SECRET: 네이버 클라우드 플랫폼 Maps(Application) — Directions 5·Geocoding 공용
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# OSRM_URL: 비우면 공용 데모 서버(초당 1회, 대량 사용 금지, 실시간 교통 미반영). 자체 서버 주소를 넣거나 off로 끈다
OSRM_URL=
# NOMINATIM_URL: 비우면 공용 서버(초당 1회). off로 끈다. NOMINATIM_EMAIL: 공용 서버 정책상 연락처(선택)
NOMINATIM_URL=
NOMINATIM_EMAIL=
