# Supabase (대시보드 → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# AI 제공자 예비 체계 — 키와 모델 id가 모두 있는 제공자만, AI_PROVIDERS 순서대로 시도
# 하나도 없으면 "AI 요약" 버튼이 "제공자 없음"으로 응답
AI_PROVIDERS=claude,openai,gemini,xai
AI_HTTP_RETRIES=2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
# 공공데이터포털 일반 인증키(Decoding) — 한국공항공사 운항 스케줄 GW + 국토교통부 TAGO 국내항공운항정보
DATA_GO_KR_KEY=
# 운항 스케줄 동기화: 호출 인증용 임의 문자열 / Supabase secret key (서버에서만 사용)
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# 다음 단계 외부 데이터 (지금은 스텁)
KAKAO_REST_KEY=
ODSAY_KEY=
